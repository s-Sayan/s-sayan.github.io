---
layout: default
---
{% comment %}
  Local override of al_folio_core's _layouts/cv.liquid (v1.0.15): identical except for the
  added <style> block below. This layout ignores the page's rendered content entirely (it
  only calls the al_folio_cv_render tag), so a fix placed in _pages/cv.md's markdown body is
  silently dropped -- it has to live here instead. If al_folio_core's cv.liquid changes
  upstream, re-sync this file and keep the <style> block.
{% endcomment %}
<style>
  /* The date badges (e.g. "2024 - present" vs "2022 - 2023") sit in a fixed-width
     .date-column that's centered (text-center), so longer badges overflow the column
     further to the left than shorter ones, making them look misaligned. Left-align instead. */
  .date-column.text-center {
    text-align: left !important;
  }
  /* al_folio_core's .list-group-item only sets border-color, relying on Bootstrap's base
     .list-group-item rule for the actual border-width/style -- but Bootstrap compat is
     disabled on this site, so that color has nothing to render and the dividers between
     entries are invisible. Give it a real border, and drop it after the last entry in each
     section so it doesn't double up with the card's own bottom edge. */
  .cv .list-group-item {
    border-bottom: 1px solid var(--global-divider-color);
  }
  .cv .list-group-item:last-child {
    border-bottom: none;
  }
  /* main.css has a generic `table:not(.table) td, table:not(.table) th { border-top: 1px
     solid ...; }` rule meant to give plain content tables (e.g. in blog posts) a lightweight
     row divider. It also matches every badge mini-table (table.table-cv isn't "table.table"),
     including Awards/Publications whose date column isn't a .date-column, adding an unwanted
     line above the badge (and above the location text, where present). Remove it everywhere
     within the CV, and top-align the row so the badge and the title line up. */
  .cv table.table-cv td,
  .cv table.table-cv th {
    border-top: none;
  }
  .cv .row {
    align-items: flex-start;
  }
  /* Default <li> bullet markers (disc) show up next to each entry since this site disables
     Tailwind's preflight reset; remove them. */
  .cv .list-group-item {
    list-style: none;
  }
  /* Browser default <ul> padding-inline-start (40px) is never reset here (no Bootstrap
     compat loaded), so each entry's border-bottom divider -- which is on the <li>, inside
     that padding -- starts 40px in from the left but runs flush to the right. Content
     should stay exactly where it is, so don't touch the ul's padding; instead pull the li
     out to the left by the same 40px (margin-left) and add it back as padding, which
     cancels out for the content but lets the border extend the full width. */
  .cv .list-group-item {
    margin-left: -40px;
    padding-left: 40px;
  }
  /* Small breathing room between the divider above and the date badge below it. */
  .cv .list-group-item {
    padding-top: 0.5rem;
  }
  /* al_folio_core's .date-column shifts its content up 5px (translateY(-5px)), which made
     sense against the old vertically-centered layout but now leaves the badge sitting flush
     against the divider above while the title (no such offset) sits normally below it.
     Cancel the vertical shift so both start at the same line; keep the horizontal shift,
     which compensates for the column's own 15px left padding. */
  .date-column {
    transform: translateX(-15px) translateY(0) !important;
  }
</style>
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
